VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — do NOT prefix with VITE_ (that would bundle it into client code).
# Get a free key at https://open.neis.go.kr, then set this in .env for local
# dev and in the Vercel project's Settings -> Environment Variables for prod.
NEIS_API_KEY=

# Google Form 누가기록 연동용 서버 전용 환경변수입니다.
# 절대 VITE_ 접두사를 붙이지 말고, 실제 값은 Vercel과 로컬 .env에만 설정하세요.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_FORM_RECORD_IMPORT_SECRET=
GOOGLE_FORM_RECORD_IMPORT_TEACHER_ID=
